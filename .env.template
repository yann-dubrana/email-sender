# Copy to .env and fill in. Values are read by pydantic-settings.
# SMTP__ is the nested prefix for the `smtp` settings group.
# Do not quote values -- systemd EnvironmentFile does not strip quotes.
# For the Debian service, see deploy/README.md -- config goes to
# /etc/email-sender/env instead of here.

SMTP__SERVER=smtp.gmail.com
SMTP__PORT=587
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROM=
SMTP__USE_SSL=false

# Default recipient. --to on the command line overrides it.
SMTP__TO=

# Seconds before a hung SMTP connection is abandoned.
SMTP__TIMEOUT=30
