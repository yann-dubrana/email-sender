# Install to /etc/email-sender/env
#   sudo install -m 600 -o root -g email-sender env.template /etc/email-sender/env
#
# systemd EnvironmentFile does NOT strip quotes: write SMTP__PASSWORD=secret,
# never SMTP__PASSWORD="secret" (the quotes become part of the password).
# No inline comments after a value either -- they are read as part of it.

SMTP__SERVER=smtp.gmail.com
SMTP__PORT=587
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROM=
SMTP__USE_SSL=false

# Default recipient. --to on the command line overrides it.
SMTP__TO=

# Seconds before a hung SMTP connection is abandoned.
SMTP__TIMEOUT=30
